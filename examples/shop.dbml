//Tables (based on the selection criteria)
//--configured at schema: shop.sales
Table "model.shop.f_order" {
  "sk_customer" "integer"
  "sk_product" "integer"
  "sk_employee" "integer"
  "order_number" "text"
  "order_status" "text" [note: 'One of placed, paid, shipped, cancelled.']
  "order_date" "date"
  "quantity" "integer" [note: 'Units ordered on this line.']
  "unit_price" "numeric" [note: 'List price at the time of ordering, before discount.']
  "amount" "numeric" [note: 'quantity * unit_price - discount.']
  "discount" "numeric" [note: 'Absolute discount on this line. Zero when none was applied.']
  "channel" "text" [note: 'Acquisition channel of the session that placed the order, from stg_web_sessions. Null when the order was placed offline.']
  "region" "text" [note: 'Geo region of the ordering session, not the shipping address.']

  Note: "One row per order line. Grain: order_number x sk_product. Amounts are net of discount, in the store currency."
}
//--configured at schema: shop.sales
Table "model.shop.f_shipment" {
  "sk_customer" "integer"
  "sk_product" "integer"
  "shipment_number" "text"
  "shipped_date" "date"
  "carrier" "text" [note: 'Carrier code as sent by the warehouse system.']

  Note: "One row per shipment. A shipment can cover several order lines; join back to f_order through stg_shipments."
}
//--configured at schema: shop.sales
Table "model.shop.d_customer" {
  "sk_customer" "integer" [note: 'Surrogate key. Stable across CRM re-imports.']
  "customer_name" "text"
  "customer_city" "text"
  "customer_segment" "text" [note: 'CRM segment: consumer, small business or enterprise.']

  Note: "Current view of every customer (type 1, no history). Sourced from the CRM."
  indexes {
    (sk_customer) [pk]
  }
}
//--configured at schema: shop.inventory
Table "model.shop.d_product" {
  "sk_product" "integer"
  "product_name" "text"
  "product_code" "text" [note: 'Human-readable SKU printed on labels. Unique, but can be reassigned after a product is discontinued.']
  "category" "text" [note: 'Top-level category only. Sub-categories are not modelled.']

  Note: "Sellable products. Discontinued products stay here so historic orders keep resolving."
  indexes {
    (sk_product) [pk]
  }
}
//--configured at schema: shop.inventory
Table "model.shop.f_stock" {
  "sk_product" "integer"
  "sk_warehouse" "integer"
  "quantity_on_hand" "integer" [note: 'Physical units in the warehouse at snapshot time, including reserved stock.']
  "reorder_level" "integer" [note: 'Purchasing raises an order when quantity_on_hand drops below this value.']

  Note: "Daily snapshot of on-hand stock per product and warehouse. Only the latest snapshot is kept."
}
//--configured at schema: shop.inventory
Table "model.shop.d_warehouse" {
  "sk_warehouse" "integer"
  "warehouse_name" "text"
  "warehouse_region" "text"

  Note: "Physical warehouses that hold stock."
  indexes {
    (sk_warehouse) [pk]
  }
}
//--configured at schema: shop.people
Table "model.shop.d_employee" {
  "sk_employee" "integer"
  "employee_name" "text"
  "department" "text" [note: 'sales, warehouse or support.']
  "hire_date" "date"

  Note: "Sales and warehouse staff. Leavers are kept for attribution of past orders."
}
//--configured at schema: shop.people
Table "model.shop.f_sales_rep" {
  "sk_employee" "integer"
  "sk_customer" "integer"
  "target_amount" "numeric" [note: 'Annual revenue target for this customer, in the store currency.']

  Note: "Sales targets per employee and customer, one row per assignment."
}
//--configured at schema: shop.staging
Table "model.shop.stg_orders" {
  "order_id" "integer"
  "customer_id" "integer"
  "product_id" "integer"
  "employee_id" "integer"
  "order_number" "text"
  "order_status" "text"
  "ordered_at" "timestamp" [note: 'Source timestamp in UTC. f_order.order_date is this value truncated to a date.']
  "quantity" "integer"
  "unit_price" "numeric"

  Note: "Cleaned copy of source.shop.orders with renamed columns. No business logic."
}
//--configured at schema: shop.staging
Table "model.shop.stg_customers" {
  "customer_id" "integer"
  "customer_name" "text"
  "customer_city" "text"
  "customer_segment" "text"

  Note: ""
}
//--configured at schema: shop.staging
Table "model.shop.stg_products" {
  "product_id" "integer"
  "product_name" "text"
  "product_code" "text"
  "category" "text"

  Note: ""
}
//--configured at schema: shop.staging
Table "model.shop.stg_employees" {
  "employee_id" "integer"
  "employee_name" "text"
  "department" "text"
  "hired_at" "timestamp"

  Note: ""
}
//--configured at schema: shop.staging
Table "model.shop.stg_inventory" {
  "product_id" "integer"
  "warehouse_id" "integer"
  "quantity_on_hand" "integer"
  "reorder_level" "integer"

  Note: ""
}
//--configured at schema: shop.staging
Table "model.shop.stg_warehouses" {
  "warehouse_id" "integer"
  "warehouse_name" "text"
  "warehouse_region" "text"

  Note: ""
}
//--configured at schema: shop.staging
Table "model.shop.stg_shipments" {
  "shipment_id" "integer"
  "order_id" "integer"
  "warehouse_id" "integer"
  "shipment_number" "text"
  "shipped_at" "timestamp"
  "carrier" "text"

  Note: ""
}
//--configured at schema: shop.staging
Table "model.shop.stg_web_sessions" {
  "session_id" "text"
  "customer_id" "integer"
  "order_id" "integer"
  "channel" "text"
  "region" "text"
  "started_at" "timestamp"

  Note: "Web sessions with a resolved customer and order, used to attribute channel and region to orders."
}
//--configured at schema: shop.raw
Table "source.shop.orders" {
  "id" "integer"
  "customer_id" "integer"
  "product_id" "integer"
  "employee_id" "integer"
  "number" "text"
  "status" "text" [note: 'Free-text status from the shop application. Normalised in stg_orders.']
  "ordered_at" "timestamp"
  "qty" "integer"
  "price" "numeric"

  Note: "Raw order lines from the shop database. Append-only."
}
//--configured at schema: shop.raw
Table "source.shop.products" {
  "id" "integer"
  "name" "text"
  "code" "text"
  "category" "text"

  Note: ""
}
//--configured at schema: shop.raw
Table "source.shop.inventory" {
  "product_id" "integer"
  "warehouse_id" "integer"
  "on_hand" "integer"
  "reorder_level" "integer"

  Note: ""
}
//--configured at schema: shop.raw
Table "source.shop.warehouses" {
  "id" "integer"
  "name" "text"
  "region" "text"

  Note: ""
}
//--configured at schema: shop.raw
Table "source.shop.shipments" {
  "id" "integer"
  "order_id" "integer"
  "warehouse_id" "integer"
  "number" "text"
  "shipped_at" "timestamp"
  "carrier" "text"

  Note: ""
}
//--configured at schema: shop.crm
Table "source.shop.customers" {
  "id" "integer"
  "full_name" "text"
  "city" "text"
  "segment" "text"

  Note: ""
}
//--configured at schema: shop.crm
Table "source.shop.employees" {
  "id" "integer"
  "full_name" "text"
  "department" "text"
  "hired_at" "timestamp"

  Note: ""
}
//--configured at schema: shop.web
Table "source.shop.web_sessions" {
  "session_id" "text"
  "customer_id" "integer"
  "order_id" "integer"
  "utm_channel" "text" [note: 'Raw utm_medium value. Empty string when the tracker had no UTM parameters.']
  "geo_region" "text"
  "started_at" "timestamp"

  Note: "Clickstream sessions from the web tracker. Late-arriving rows are common."
}
//Refs (based on the DBT Relationship Tests)
Ref: "model.shop.f_order"."sk_customer" > "model.shop.d_customer"."sk_customer"
Ref: "model.shop.f_order"."sk_product" > "model.shop.d_product"."sk_product"
Ref: "model.shop.f_order"."sk_employee" > "model.shop.d_employee"."sk_employee"
Ref: "model.shop.f_shipment"."sk_customer" > "model.shop.d_customer"."sk_customer"
Ref: "model.shop.f_shipment"."sk_product" > "model.shop.d_product"."sk_product"
Ref: "model.shop.f_stock"."sk_product" > "model.shop.d_product"."sk_product"
Ref: "model.shop.f_stock"."sk_warehouse" > "model.shop.d_warehouse"."sk_warehouse"
Ref: "model.shop.f_sales_rep"."sk_employee" > "model.shop.d_employee"."sk_employee"
Ref: "model.shop.f_sales_rep"."sk_customer" > "model.shop.d_customer"."sk_customer"
//TableGroups (based on the table schema)
TableGroup "shop.sales" {
  "model.shop.f_order"
  "model.shop.f_shipment"
  "model.shop.d_customer"
}
TableGroup "shop.inventory" {
  "model.shop.d_product"
  "model.shop.f_stock"
  "model.shop.d_warehouse"
}
TableGroup "shop.people" {
  "model.shop.d_employee"
  "model.shop.f_sales_rep"
}
TableGroup "shop.staging" {
  "model.shop.stg_orders"
  "model.shop.stg_customers"
  "model.shop.stg_products"
  "model.shop.stg_employees"
  "model.shop.stg_inventory"
  "model.shop.stg_warehouses"
  "model.shop.stg_shipments"
  "model.shop.stg_web_sessions"
}
TableGroup "shop.raw" {
  "source.shop.orders"
  "source.shop.products"
  "source.shop.inventory"
  "source.shop.warehouses"
  "source.shop.shipments"
}
TableGroup "shop.crm" {
  "source.shop.customers"
  "source.shop.employees"
}
TableGroup "shop.web" {
  "source.shop.web_sessions"
}
//Deps (based on the DBT DAG)
Dep {
  "model.shop.stg_customers" -> "model.shop.d_customer"
}
Dep {
  "model.shop.stg_employees" -> "model.shop.d_employee"
}
Dep {
  "model.shop.stg_products" -> "model.shop.d_product"
}
Dep {
  "model.shop.stg_warehouses" -> "model.shop.d_warehouse"
}
Dep {
  "model.shop.stg_customers" -> "model.shop.f_order"
  "model.shop.stg_orders" -> "model.shop.f_order"
  "model.shop.stg_web_sessions" -> "model.shop.f_order"
}
Dep {
  "model.shop.stg_employees" -> "model.shop.f_sales_rep"
  "model.shop.stg_orders" -> "model.shop.f_sales_rep"
}
Dep {
  "model.shop.stg_shipments" -> "model.shop.f_shipment"
  "model.shop.stg_warehouses" -> "model.shop.f_shipment"
}
Dep {
  "model.shop.stg_inventory" -> "model.shop.f_stock"
}
Dep {
  "source.shop.customers" -> "model.shop.stg_customers"
}
Dep {
  "source.shop.employees" -> "model.shop.stg_employees"
}
Dep {
  "source.shop.inventory" -> "model.shop.stg_inventory"
}
Dep {
  "source.shop.orders" -> "model.shop.stg_orders"
}
Dep {
  "source.shop.products" -> "model.shop.stg_products"
}
Dep {
  "source.shop.shipments" -> "model.shop.stg_shipments"
}
Dep {
  "source.shop.warehouses" -> "model.shop.stg_warehouses"
}
Dep {
  "source.shop.web_sessions" -> "model.shop.stg_web_sessions"
}
