//Tables (based on the selection criteria)
//--configured at schema: shop.sales
Table "model.shop.f_order" {
  "sk_customer" "integer"
  "sk_product" "integer"
  "sk_employee" "integer"
  "order_number" "text"
  "order_status" "text"
  "order_date" "date"
  "quantity" "integer"
  "unit_price" "numeric"
  "amount" "numeric"
  "discount" "numeric"
  "channel" "text"
  "region" "text"

  Note: ""
}
